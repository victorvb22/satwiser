# Root folder for raw downloads and intermediate products (outside the repo).
SATWISER_DATA_DIR=/path/to/satwiser-data

# API (backend/). "local" reads $SATWISER_DATA_DIR/app; "database" reads DATABASE_URL.
SATWISER_DATA_BACKEND=local
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
CORS_ORIGINS=http://localhost:5173
# Lab windows in object storage (database backend), e.g.
# SATWISER_LAB_STORAGE_URL=https://PROJECT.supabase.co/storage/v1/object/public/lab-windows
# Upload script only (never on the server that faces the public):
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_SERVICE_KEY=...
